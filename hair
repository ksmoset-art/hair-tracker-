      // Robust Dual-Transmission to Google Apps Script
      // Bypasses CORS iframe blocks by leveraging hidden form submission + fetch
      function pushToGoogleSheet(silent = false) {
        if (!state.webhookUrl) {
          if (!silent) showToast('請先填入您的 Google Apps Script 網址');
          return;
        }
        try {
          if (!silent) showToast('☁️ 正在發送至 Google Sheet...');
          
          // Method 1: Invisible Form Submit (never blocked by CORS across domains)
          let sinkFrame = document.getElementById('gscript_sink_iframe');
          if (!sinkFrame) {
            sinkFrame = document.createElement('iframe');
            sinkFrame.id = 'gscript_sink_iframe';
            sinkFrame.name = 'gscript_sink_iframe';
            sinkFrame.style.display = 'none';
            document.body.appendChild(sinkFrame);
          }
          let sinkForm = document.getElementById('gscript_post_form');
          if (!sinkForm) {
            sinkForm = document.createElement('form');
            sinkForm.id = 'gscript_post_form';
            sinkForm.method = 'POST';
            sinkForm.target = 'gscript_sink_iframe';
            sinkForm.style.display = 'none';
            const hiddenInp = document.createElement('input');
            hiddenInp.type = 'hidden';
            hiddenInp.name = 'postData';
            hiddenInp.id = 'gscript_post_input';
            sinkForm.appendChild(hiddenInp);
            document.body.appendChild(sinkForm);
          }
          sinkForm.action = state.webhookUrl;
          document.getElementById('gscript_post_input').value = JSON.stringify(state);
          sinkForm.submit();

          // Method 2: Also send via Fetch no-cors for modern environments
          try {
            fetch(state.webhookUrl, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify(state)
            }).catch(() => {});
          } catch (e) {}

          if (!silent) {
            showToast('✅ 已送出同步請求！請稍候 3~5 秒查看 Google 試算表');
          }
        } catch (err) {
          if (!silent) showToast('⚠️ 發送失敗，但本機已完整儲存');
        }
      }

      async function pullFromGoogleSheet() {
        if (!state.webhookUrl) {
          showToast('請先輸入 Google Apps Script 網址');
          return;
        }
        try {
          showToast('☁️ 正在從 Google Sheet 讀取資料...');
          const res = await fetch(state.webhookUrl);
          const data = await res.json();
          if (data && Array.isArray(data.days)) {
            normalizeAndMergeState(data);
            saveState(false);
            renderAll();
            showToast('✅ 已從 Google Sheet 載入最新 28 天紀錄！');
          } else if (data && data.status === 'ok') {
            showToast(data.message || '連線成功，試算表尚無舊紀錄');
          } else {
            showToast('試算表尚無已存紀錄，請先點擊「立即同步到 Google Sheet」');
          }
        } catch (err) {
          showToast('⚠️ 讀取失敗，請確認 Apps Script 部署「誰可以存取」設為所有人');
        }
      }

      async function testWebhookConnection() {
        const diagBox = document.getElementById('diagResultBox');
        diagBox.classList.remove('hidden');
        diagBox.innerHTML = '⏳ 正在探測 Google Apps Script 網址狀態...';

        const url = state.webhookUrl;
        if (!url) {
          diagBox.innerHTML = '<span class="text-rose-600 font-bold">❌ 尚未填寫網址！</span>';
          return;
        }

        try {
          const res = await fetch(url, { method: 'GET' });
          const text = await res.text();
          let json = null;
          try { json = JSON.parse(text); } catch (e) {}

          if (json && json.status === 'ok') {
            diagBox.innerHTML = `
              <div class="text-emerald-700 font-bold">✅ 連線測試成功！Google Apps Script 回應正常。</div>
              <div class="text-slate-600">伺服器訊息：${json.message || '已成功連接到試算表'}</div>
            `;
          } else if (text.includes('accounts.google.com') || text.includes('Sign in')) {
            diagBox.innerHTML = `
              <div class="text-rose-600 font-bold">⚠️ 權限錯誤：被引導至 Google 登入畫面！</div>
              <div class="text-slate-700">這表示 Apps Script 部署時「<strong>誰可以存取 (Who has access)</strong>」沒有選為「<strong>所有人 (Anyone)</strong>」。請進入 Apps Script 點選管理部署作業修改為所有人！</div>
            `;
          } else {
            diagBox.innerHTML = `
              <div class="text-amber-700 font-bold">⚠️ 已連上伺服器，但回應非預期：</div>
              <div class="font-mono text-[10px] truncate">${text.slice(0, 100)}...</div>
              <div class="text-slate-600">請確認是否已複製專用加強版代碼並選「新版本」部署。</div>
            `;
          }
        } catch (err) {
          diagBox.innerHTML = `
            <div class="text-rose-600 font-bold">⚠️ 無法以 GET 探測（可能是瀏覽器沙盒或跨域安全策略）</div>
            <div class="text-slate-600">點擊「立即同步到 Google Sheet」會改用表單直送模式寫入。如仍無法寫入，請直接在瀏覽器另開分頁貼上該網址：若出現授權錯誤，請依下方 3 步驟修正。</div>
          `;
        }
      }

      // Copy text helper with fallback
      function copyTextToClipboard(text, successMsg) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(() => {
            showToast(successMsg);
          }).catch(() => fallbackCopy(text, successMsg));
        } else {
          fallbackCopy(text, successMsg);
        }
      }

      function fallbackCopy(text, successMsg) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showToast(successMsg);
        } catch (err) {
          showToast('複製失敗，請手動選取複製');
        }
        document.body.removeChild(ta);
      }

