      // Initialize App: load from localStorage or fallback to IndexedDB
      function initApp() {
        let loaded = null;
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) loaded = JSON.parse(raw);
        } catch (err) {}

        if (loaded) {
          normalizeAndMergeState(loaded);
          bindEvents();
          renderAll();
          updateMidnightClock();
          setInterval(updateMidnightClock, 15000);
        } else {
          loadFromIndexedDB(idbData => {
            if (idbData) {
              normalizeAndMergeState(idbData);
            } else {
              alignSelectedDayToToday();
            }
            bindEvents();
            renderAll();
            updateMidnightClock();
            setInterval(updateMidnightClock, 15000);
          });
        }
      }

      window.addEventListener('DOMContentLoaded', initApp);
    })();
  </script>
</body>
</html>
