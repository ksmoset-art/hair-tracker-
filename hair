<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="28天掉髮與鐵劑紀錄" />
  <title>28天掉髮與鐵劑 (Fe³⁺ 100mg) 追蹤小工具</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    body {
      font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .tap-btn {
      transition: transform 0.08s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.15s ease;
      user-select: none;
    }
    .tap-btn:active {
      transform: scale(0.95);
    }
    .pulse-ring {
      animation: pulseRing 0.4s ease-out;
    }
    @keyframes pulseRing {
      0% { transform: scale(0.96); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.45); }
      70% { transform: scale(1.02); box-shadow: 0 0 0 14px rgba(244, 63, 94, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
    }
    .custom-scrollbar::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen pb-24">

  <!-- Top Header & Storage Status Bar -->
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
    <div class="max-w-xl mx-auto px-4 py-3 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold shadow-sm">
          28
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-900 leading-tight">28天掉髮 &amp; Fe³⁺ 鐵劑紀錄</h1>
          <div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
            <span id="saveStatusBadge" class="inline-flex items-center gap-1 text-emerald-600 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              本機儲存中
            </span>
            <span>•</span>
            <span id="midnightCountdown" class="text-slate-500">00:00 自動結算</span>
          </div>
        </div>
      </div>

      <button id="openSyncModalBtn" type="button" class="tap-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
        </svg>
        <span id="syncBtnLabel">Google Sheet 設定</span>
      </button>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 pt-4 space-y-4">

    <!-- Critical Environment Alert Banner (Explaining Gemini preview vs GitHub Pages) -->
    <div id="envNoticeBanner" class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 text-xs text-amber-950 flex items-start gap-2.5">
      <span class="text-lg shrink-0">⚠️</span>
      <div class="space-y-1">
        <div class="font-bold text-amber-900">為什麼在 Gemini 預覽連結會重整消失或無法連到 Google Sheet？</div>
        <p class="text-amber-800 leading-relaxed">
          因為 <code>gemini.google.com/share/...</code> 是 Google 聊天分享畫面，瀏覽器會把程式放在<strong>受限的隔離沙盒（iframe）</strong>中，每次重整會重置暫存，並阻擋對外發送請求。
        </p>
        <div class="font-bold text-amber-900 pt-0.5">
          👉 解決方法：將本檔案發布到 <strong>GitHub Pages</strong>（免費 1 分鐘搞定），擁有自己的專屬網址後，手機儲存永遠不遺失，且 Google Sheet 100% 成功寫入！
        </div>
      </div>
    </div>

    <!-- 28-Day Progress & Day Selector Strip -->
    <section class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80">
      <div class="flex items-center justify-between mb-2.5">
        <div class="flex items-center gap-2">
          <span id="currentDayBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-700">
            第 1 / 28 天
          </span>
          <span id="selectedDateText" class="text-sm font-semibold text-slate-800">2026-10-28</span>
          <span id="isTodayTag" class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-slate-900 text-white">今天</span>
        </div>
        <div class="flex items-center gap-1">
          <button id="prevDayBtn" type="button" class="tap-btn p-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" title="前一天">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="jumpTodayBtn" type="button" class="tap-btn px-2.5 py-1 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">
            回今天
          </button>
          <button id="nextDayBtn" type="button" class="tap-btn p-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50" title="後一天">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Horizontal 28-day pills -->
      <div id="dayStripContainer" class="flex items-center gap-1.5 overflow-x-auto custom-scrollbar pb-1.5 pt-0.5">
        <!-- Populated by JS -->
      </div>
    </section>

    <!-- Main Hair Fall Counter & Wash Day Card -->
    <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 relative overflow-hidden">
      <div class="flex items-start justify-between gap-3 mb-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">當日累積掉髮總量 (00:00 自動整合)</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="dailyTotalDisplay" class="text-5xl font-black tracking-tight text-slate-900">0</span>
            <span class="text-base font-semibold text-slate-500">根</span>
            <span id="dailyBreakdownText" class="text-xs text-slate-400 ml-1">(日常 0 + 洗頭 0)</span>
          </div>
        </div>

        <!-- Wash Day Toggle Button -->
        <button id="washDayToggleBtn" type="button" class="tap-btn flex flex-col items-center justify-center px-3.5 py-2.5 rounded-2xl border-2 transition-all">
          <div class="flex items-center gap-1.5">
            <span class="text-lg">🚿</span>
            <span id="washDayBtnTitle" class="text-sm font-bold">洗頭日</span>
          </div>
          <span id="washDayStatusText" class="text-[11px] font-medium mt-0.5">點擊標記今日洗頭</span>
        </button>
      </div>

      <!-- Primary Giant Tap Button for Touching Hair Fall -->
      <div class="grid grid-cols-1 gap-3">
        <button id="mainAddOneBtn" type="button" class="tap-btn w-full py-5 px-6 rounded-2xl bg-gradient-to-r from-rose-500 to-pink-600 hover:from-rose-600 hover:to-pink-700 text-white shadow-md shadow-rose-500/20 flex items-center justify-between">
          <div class="text-left">
            <div class="text-xl font-extrabold flex items-center gap-2">
              <span>✋ 摸到掉髮 按一下</span>
              <span id="tapModeBadge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-white/20">計入日常掉髮</span>
            </div>
            <p class="text-xs text-rose-100 mt-0.5">隨摸隨按，系統自動記錄時間並於 00:00 結算當日總量</p>
          </div>
          <div class="text-3xl font-black bg-white/20 w-14 h-14 rounded-2xl flex items-center justify-center shrink-0">
            +1
          </div>
        </button>

        <!-- Quick Multi-Add & Wash Hair Count Row -->
        <div class="grid grid-cols-4 gap-2">
          <button id="addFiveBtn" type="button" class="tap-btn py-2.5 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-sm border border-rose-200/80">
            +5 根
          </button>
          <button id="addTenBtn" type="button" class="tap-btn py-2.5 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-sm border border-rose-200/80">
            +10 根
          </button>
          <button id="addWashBatchBtn" type="button" class="tap-btn py-2.5 px-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 font-bold text-xs border border-sky-200/80 flex flex-col items-center justify-center leading-tight">
            <span>🚿 洗頭掉髮</span>
            <span class="text-[10px] font-medium text-sky-600">+輸入數量</span>
          </button>
          <button id="minusOneBtn" type="button" class="tap-btn py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-sm border border-slate-200">
            -1 復原
          </button>
        </div>

        <!-- Inline Wash Hair or Custom Input Drawer (Hidden unless clicked) -->
        <div id="customInputDrawer" class="hidden bg-slate-50 border border-slate-200 rounded-xl p-3">
          <div class="flex items-center justify-between mb-2">
            <span id="customDrawerTitle" class="text-xs font-bold text-slate-700">🚿 記錄洗頭時掉髮數量 (自動開啟洗頭日標記)</span>
            <button id="closeCustomDrawerBtn" type="button" class="text-xs text-slate-400 hover:text-slate-600">關閉 ✕</button>
          </div>
          <div class="flex items-center gap-2">
            <input id="customHairCountInput" type="number" min="1" max="1000" placeholder="輸入根數 (例如 35)" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
            <button id="confirmCustomHairBtn" type="button" class="tap-btn shrink-0 px-4 py-2 rounded-lg bg-sky-600 text-white text-sm font-bold hover:bg-sky-700">
              加入紀錄
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Iron Supplement (Fe3+ 100mg 2 Meals) Card -->
    <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-extrabold text-sm">
            Fe³⁺
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">鐵劑補充紀錄 (Fe³⁺ 100mg × 兩餐)</h2>
            <p class="text-xs text-slate-500">請勾選今日是哪兩餐服用 (每餐 100mg，目標 200mg/日)</p>
          </div>
        </div>
        <span id="ironStatusBadge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-600">
          0 / 2 餐 (0mg)
        </span>
      </div>

      <!-- 3 Meal Checkboxes: Breakfast, Lunch, Dinner -->
      <div class="grid grid-cols-3 gap-2.5">
        <button id="mealBreakfastBtn" type="button" data-meal="breakfast" class="tap-btn flex flex-col items-center justify-center p-3 rounded-xl border-2 transition-all">
          <div class="flex items-center gap-1.5">
            <span class="text-base">🌅</span>
            <span class="text-sm font-bold">早餐吃</span>
          </div>
          <span class="text-[11px] mt-1 font-medium">Fe³⁺ 100mg</span>
          <span id="checkBreakfast" class="mt-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold">未勾選</span>
        </button>

        <button id="mealLunchBtn" type="button" data-meal="lunch" class="tap-btn flex flex-col items-center justify-center p-3 rounded-xl border-2 transition-all">
          <div class="flex items-center gap-1.5">
            <span class="text-base">☀️</span>
            <span class="text-sm font-bold">午餐吃</span>
          </div>
          <span class="text-[11px] mt-1 font-medium">Fe³⁺ 100mg</span>
          <span id="checkLunch" class="mt-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold">未勾選</span>
        </button>

        <button id="mealDinnerBtn" type="button" data-meal="dinner" class="tap-btn flex flex-col items-center justify-center p-3 rounded-xl border-2 transition-all">
          <div class="flex items-center gap-1.5">
            <span class="text-base">🌙</span>
            <span class="text-sm font-bold">晚餐吃</span>
          </div>
          <span class="text-[11px] mt-1 font-medium">Fe³⁺ 100mg</span>
          <span id="checkDinner" class="mt-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold">未勾選</span>
        </button>
      </div>
    </section>

    <!-- Trend Chart Card (Hair Fall vs Iron Intake & Wash Days) -->
    <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900">📈 28天掉髮趨勢 vs. 鐵劑成效曲線表</h2>
          <p class="text-xs text-slate-500">觀察服用 Fe³⁺ 100mg 後日常掉髮與洗頭日掉髮是否隨天數下降</p>
        </div>

        <!-- Chart Filter Mode -->
        <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold">
          <button id="chartFilterAllBtn" type="button" class="px-2.5 py-1 rounded-lg bg-white text-slate-900 shadow-sm">全部天數</button>
          <button id="chartFilterNonWashBtn" type="button" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900">僅非洗頭日</button>
          <button id="chartFilterWashOnlyBtn" type="button" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900">僅洗頭日</button>
        </div>
      </div>

      <!-- KPI Summary Strip for Trend Evaluation -->
      <div class="grid grid-cols-3 gap-2 mb-4">
        <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-100">
          <div class="text-[11px] text-slate-500">非洗頭日平均</div>
          <div id="statNonWashAvg" class="text-base font-extrabold text-slate-800 mt-0.5">-- 根</div>
        </div>
        <div class="bg-sky-50/70 rounded-xl p-2.5 border border-sky-100">
          <div class="text-[11px] text-sky-700">洗頭日平均</div>
          <div id="statWashAvg" class="text-base font-extrabold text-sky-900 mt-0.5">-- 根</div>
        </div>
        <div class="bg-amber-50/70 rounded-xl p-2.5 border border-amber-100">
          <div class="text-[11px] text-amber-800">鐵劑達標天數</div>
          <div id="statIronDays" class="text-base font-extrabold text-amber-900 mt-0.5">0 天</div>
        </div>
      </div>

      <!-- Fixed-height Chart Container per Rule 4 -->
      <div class="relative h-72 w-full">
        <canvas id="trendChartCanvas"></canvas>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 mt-3 text-[11px] text-slate-500">
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block"></span> 一般日掉髮總量</span>
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-sky-500 inline-block"></span> 洗頭日標記 (🚿)</span>
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-amber-400/70 inline-block"></span> Fe³⁺ 鐵劑攝取 (mg)</span>
      </div>
    </section>

    <!-- Today's Tap Timestamps & 28-Day Overview Table -->
    <section class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
        <div class="flex gap-2">
          <button id="tabDailyLogBtn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-white">
            當日按壓明細 (<span id="todayLogCount">0</span>)
          </button>
          <button id="tabAllDaysBtn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200">
            28天總覽表
          </button>
        </div>
        <button id="clearTodayBtn" type="button" class="text-xs text-slate-400 hover:text-rose-600 font-medium">
          重置當日
        </button>
      </div>

      <!-- Tab 1: Today's Tap Events -->
      <div id="dailyLogPanel" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar">
        <!-- Populated by JS -->
      </div>

      <!-- Tab 2: 28-Day Summary Table -->
      <div id="allDaysTablePanel" class="hidden overflow-x-auto max-h-80 custom-scrollbar">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500">
              <th class="py-2 px-2">天數 / 日期</th>
              <th class="py-2 px-2">洗頭日</th>
              <th class="py-2 px-2">當日總掉髮</th>
              <th class="py-2 px-2">Fe³⁺ 鐵劑 (100mg)</th>
            </tr>
          </thead>
          <tbody id="allDaysTableBody" class="divide-y divide-slate-100">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- GitHub Pages 1-Minute Setup Guide Card -->
    <section class="bg-slate-900 text-slate-100 rounded-2xl p-4 shadow-sm text-xs space-y-3">
      <div class="font-bold text-sm flex items-center gap-1.5 text-amber-300">
        <span>🚀</span>
        <span>強烈推薦：1 分鐘放上 GitHub Pages 擁有專屬手機 App</span>
      </div>
      <div class="text-slate-300 space-y-1.5 leading-relaxed">
        <p>Gemini 分享畫面只是靜態展示用的預覽框，<strong>不能當作真正的日常 App 使用</strong>。只要放上 GitHub Pages：</p>
        <ol class="list-decimal pl-4 space-y-1 text-slate-200">
          <li>到 <a href="https://github.com" target="_blank" class="text-amber-400 underline font-semibold">GitHub.com</a> 建立一個公開儲存庫（Repository，例如 <code>hair-tracker</code>）。</li>
          <li>點擊「<strong>Upload files</strong>」，將此 <code>index.html</code> 拖曳上傳並 Commit。</li>
          <li>進入儲存庫的「<strong>Settings → Pages</strong>」，Branch 選擇 <code>main</code> 並儲存。</li>
          <li>約 30 秒後就會獲得專屬網址 <code>https://你的帳號.github.io/hair-tracker/</code>！</li>
        </ol>
        <p class="text-emerald-400 font-semibold pt-1">
          ✓ 手機資料永遠不遺失、可加入 iPhone/Android 主畫面、Google Sheet 100% 成功同步！
        </p>
      </div>
    </section>

  </main>

  <!-- Modal: Google Sheet Cloud Sync & Backup / Restore -->
  <div id="syncModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto p-5 shadow-xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-base font-bold text-slate-900">☁️ Google Sheet 雲端同步 &amp; 診斷</h3>
          <p class="text-xs text-slate-500">已為您配置 Google Apps Script 雙向連動引擎</p>
        </div>
        <button id="closeSyncModalBtn" type="button" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100">✕</button>
      </div>

      <!-- Option 1: Google Sheets Webhook Integration -->
      <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-emerald-900">Google Sheet Webhook 網址設定</span>
          <span id="webhookStatusPill" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white">已綁定網址</span>
        </div>

        <div class="space-y-1.5">
          <label class="block text-[11px] font-semibold text-emerald-900">Google Apps Script 網頁應用程式網址：</label>
          <input id="webhookUrlInput" type="url" placeholder="https://script.google.com/macros/s/xxxxxx/exec" class="w-full px-3 py-2 rounded-lg border border-emerald-300 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono text-[11px]" />
        </div>

        <div class="flex flex-wrap gap-2 pt-1">
          <button id="saveWebhookBtn" type="button" class="tap-btn px-3 py-2 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 shadow-sm flex items-center gap-1">
            <span>⬆</span> 立即同步到 Google Sheet
          </button>
