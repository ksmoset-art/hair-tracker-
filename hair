      const DEFAULT_USER_WEBHOOK = 'https://script.google.com/macros/s/AKfycbwIoWaHTgxuLb0etFd7uehvNDeP95YMRZkEx4DRTDNSE3XSm2sawZwRwj7PgSLjO_Q/exec';

      // Format YYYY-MM-DD in local time
      function formatLocalYMD(dateObj) {
        const y = dateObj.getFullYear();
        const m = String(dateObj.getMonth() + 1).padStart(2, '0');
        const d = String(dateObj.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
      }

      function addDaysToYMD(ymdStr, daysToAdd) {
        const parts = ymdStr.split('-').map(Number);
        const dt = new Date(parts[0], parts[1] - 1, parts[2]);
        dt.setDate(dt.getDate() + daysToAdd);
        return formatLocalYMD(dt);
      }

      function getTodayYMD() {
        return formatLocalYMD(new Date());
      }

      function createEmptyDay(dateStr) {
        return {
          date: dateStr,
          touchCount: 0,
          washCount: 0,
          isWashDay: false,
          iron: {
            breakfast: false,
            lunch: false,
            dinner: false
          },
          logs: [] // { time: '22:05:12', delta: 1, type: 'touch' | 'wash' }
        };
      }

      function buildDefaultState(startDateStr) {
        const days = [];
        for (let i = 0; i < 28; i++) {
          days.push(createEmptyDay(addDaysToYMD(startDateStr, i)));
        }
        return {
          startDate: startDateStr,
          selectedDayIndex: 0,
          webhookUrl: DEFAULT_USER_WEBHOOK,
          chartFilter: 'all', // 'all' | 'nonWash' | 'washOnly'
          days: days
        };
      }

      // IndexedDB helper for dual persistence
      function saveToIndexedDB(stateObj) {
        try {
          if (!window.indexedDB) return;
          const req = window.indexedDB.open(IDB_NAME, 1);
          req.onupgradeneeded = function (e) {
            const db = e.target.result;
            if (!db.objectStoreNames.contains(IDB_STORE)) {
              db.createObjectStore(IDB_STORE);
            }
          };
          req.onsuccess = function (e) {
            const db = e.target.result;
            const tx = db.transaction(IDB_STORE, 'readwrite');
            tx.objectStore(IDB_STORE).put(JSON.stringify(stateObj), STORAGE_KEY);
          };
        } catch (err) {}
      }

      function loadFromIndexedDB(callback) {
        try {
          if (!window.indexedDB) { callback(null); return; }
          const req = window.indexedDB.open(IDB_NAME, 1);
          req.onupgradeneeded = function (e) {
            const db = e.target.result;
            if (!db.objectStoreNames.contains(IDB_STORE)) {
              db.createObjectStore(IDB_STORE);
            }
          };
          req.onsuccess = function (e) {
            const db = e.target.result;
            const tx = db.transaction(IDB_STORE, 'readonly');
            const getReq = tx.objectStore(IDB_STORE).get(STORAGE_KEY);
            getReq.onsuccess = function () {
              if (getReq.result) {
                try { callback(JSON.parse(getReq.result)); return; } catch (ex) {}
              }
              callback(null);
            };
            getReq.onerror = function () { callback(null); };
          };
          req.onerror = function () { callback(null); };
        } catch (err) {
          callback(null);
        }
      }

      let state = buildDefaultState(getTodayYMD());
      let lastKnownTodayYMD = getTodayYMD();
      let trendChart = null;
      let syncDebounceTimer = null;

      function showToast(msg) {
        const box = document.getElementById('toastBox');
        if (!box) return;
        box.textContent = msg;
        box.classList.remove('opacity-0');
        box.classList.add('opacity-100');
        clearTimeout(box._hideTimer);
        box._hideTimer = setTimeout(() => {
          box.classList.remove('opacity-100');
          box.classList.add('opacity-0');
        }, 2400);
      }

      function saveState(triggerCloud = true) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (err) {}
        saveToIndexedDB(state);

        const badge = document.getElementById('saveStatusBadge');
        if (badge) {
          const nowStr = new Date().toLocaleTimeString('zh-TW', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
          badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span>已儲存 (${nowStr})`;
        }

        if (triggerCloud && state.webhookUrl) {
          clearTimeout(syncDebounceTimer);
          syncDebounceTimer = setTimeout(() => {
            pushToGoogleSheet(true);
          }, 1200);
        }
      }

      function normalizeAndMergeState(loaded) {
        if (!loaded || !Array.isArray(loaded.days) || loaded.days.length !== 28) return;
        state.startDate = loaded.startDate || getTodayYMD();
        state.webhookUrl = loaded.webhookUrl || DEFAULT_USER_WEBHOOK;
        state.chartFilter = loaded.chartFilter || 'all';
        state.days = loaded.days.map((d, i) => ({
          date: d.date || addDaysToYMD(state.startDate, i),
          touchCount: Number(d.touchCount) || 0,
          washCount: Number(d.washCount) || 0,
          isWashDay: Boolean(d.isWashDay),
          iron: {
            breakfast: Boolean(d.iron && d.iron.breakfast),
            lunch: Boolean(d.iron && d.iron.lunch),
            dinner: Boolean(d.iron && d.iron.dinner)
          },
          logs: Array.isArray(d.logs) ? d.logs : []
        }));
        alignSelectedDayToToday();
      }

      function alignSelectedDayToToday() {
        const todayStr = getTodayYMD();
        const matchIdx = state.days.findIndex(d => d.date === todayStr);
        if (matchIdx !== -1) {
          state.selectedDayIndex = matchIdx;
        } else if (state.selectedDayIndex < 0 || state.selectedDayIndex >= 28) {
          state.selectedDayIndex = 0;
        }
      }

      // Check midnight 00:00 rollover & countdown
      function updateMidnightClock() {
        const now = new Date();
        const currentYMD = formatLocalYMD(now);
        if (currentYMD !== lastKnownTodayYMD) {
          lastKnownTodayYMD = currentYMD;
          alignSelectedDayToToday();
          saveState(true);
          renderAll();
          showToast('🕛 已過 00:00！系統已自動整合昨日總量並切換至新的一天');
        }
        const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0);
        const diffSec = Math.max(0, Math.floor((tomorrow - now) / 1000));
        const hrs = String(Math.floor(diffSec / 3600)).padStart(2, '0');
        const mins = String(Math.floor((diffSec % 3600) / 60)).padStart(2, '0');
        const countdownEl = document.getElementById('midnightCountdown');
        if (countdownEl) {
          countdownEl.textContent = `距 00:00 結算剩 ${hrs}:${mins}`;
        }
      }

      function getCurrentDayObj() {
        return state.days[state.selectedDayIndex] || state.days[0];
      }

      function recordHairFall(delta, type) {
        const day = getCurrentDayObj();
        const nowTime = new Date().toLocaleTimeString('zh-TW', { hour12: false });

        if (type === 'wash') {
          day.washCount = Math.max(0, day.washCount + delta);
          if (delta > 0) day.isWashDay = true;
        } else {
          day.touchCount = Math.max(0, day.touchCount + delta);
        }

        if (delta > 0) {
          day.logs.unshift({
            time: nowTime,
            delta: delta,
            type: type
          });
        } else if (delta < 0 && day.logs.length > 0) {
          day.logs.shift();
        }

        const totalEl = document.getElementById('dailyTotalDisplay');
        if (totalEl) {
          totalEl.classList.remove('pulse-ring');
          void totalEl.offsetWidth;
          totalEl.classList.add('pulse-ring');
